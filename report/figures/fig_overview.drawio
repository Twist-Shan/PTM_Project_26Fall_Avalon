none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="646" y="10" width="262" height="22" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;A game record&lt;/b&gt;&amp;nbsp; &lt;font color="#5E5D59"&gt;6 players, 2 of them evil&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;quest 1: seats 1–2 &amp;nbsp;→&amp;nbsp; one Fail card&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;quest 2: seats 3–5 &amp;nbsp;→&amp;nbsp; one Fail card&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#141413;rounded=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#DEDCD3;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=6;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="12" y="40" width="262" height="82" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;A point of view&lt;/b&gt;&amp;nbsp; &lt;font color="#5E5D59"&gt;(optional)&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;“I am seat 6, Percival. At setup I&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;saw seats 1 and 3.”&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#141413;rounded=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#DEDCD3;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=6;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="12" y="132" width="262" height="82" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;A claim&lt;/b&gt;&lt;br&gt;C&lt;sub&gt;1&lt;/sub&gt;&amp;nbsp; seat 6 is good&lt;br&gt;C&lt;sub&gt;2&lt;/sub&gt;&amp;nbsp; the evil team is seats 1 and 3" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#141413;rounded=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#D97757;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=9;spacingRight=6;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="12" y="224" width="262" height="82" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Z3 model of 31 rule clauses&lt;/b&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;every constraint keeps its clause id,&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;e.g. &lt;font face="Consolas" style="font-size:12px"&gt;Q-GOOD@q1:2&lt;/font&gt;, &lt;font face="Consolas" style="font-size:12px"&gt;K-PERCIVAL@3&lt;/font&gt;&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#141413;rounded=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#DEDCD3;strokeWidth=1;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="329" y="40" width="262" height="82" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;three satisfiability checks&lt;/b&gt;&lt;br&gt;&lt;i&gt;B&lt;/i&gt; ? &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;i&gt;B&lt;/i&gt; &lt;font face="Cambria Math"&gt;∧&lt;/font&gt; &lt;i&gt;C&lt;/i&gt; ? &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;i&gt;B&lt;/i&gt; &lt;font face="Cambria Math"&gt;∧&lt;/font&gt; &lt;font face="Cambria Math"&gt;¬&lt;/font&gt;&lt;i&gt;C&lt;/i&gt; ?' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#141413;rounded=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#DEDCD3;strokeWidth=1;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="329" y="140" width="262" height="54" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=blockThin;endFill=1;endSize=7;strokeColor=#87867F;strokeWidth=1.6;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="122" as="sourcePoint"/><mxPoint x="460.0" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=blockThin;endFill=1;endSize=7;strokeColor=#87867F;strokeWidth=1.6;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="194" as="sourcePoint"/><mxPoint x="460.0" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;entailed&lt;/b&gt;&lt;br&gt;C&lt;sub&gt;1&lt;/sub&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12.5;fontColor=#FFFFFF;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=0;fillColor=#D97757;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="329" y="224" width="128" height="39" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;contradicted&lt;/b&gt;&lt;br&gt;C&lt;sub&gt;2&lt;/sub&gt;, for Percival" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12.5;fontColor=#FFFFFF;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=0;fillColor=#E49C7F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="463" y="224" width="128" height="39" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;undetermined&lt;/b&gt;&lt;br&gt;C&lt;sub&gt;2&lt;/sub&gt;, for an observer" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12.5;fontColor=#141413;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#D97757;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="329" y="267" width="128" height="39" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;inconsistent&lt;/b&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;illegal record&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=12.5;fontColor=#141413;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#5E5D59;strokeWidth=1.2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="463" y="267" width="128" height="39" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Proof of C&lt;sub&gt;1&lt;/sub&gt;&lt;/b&gt;&amp;nbsp; &lt;font color="#5E5D59"&gt;a minimal clause core&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;&lt;font face="Consolas" style="font-size:12px"&gt;S-DEAL&lt;/font&gt;: only 2 of the 6 are evil&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;&lt;font face="Consolas" style="font-size:12px"&gt;Q-GOOD&lt;/font&gt;: each Fail needs an evil player&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#141413;rounded=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#DEDCD3;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=6;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="646" y="40" width="262" height="82" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;Counterexample for C&lt;sub&gt;2&lt;/sub&gt;&lt;/b&gt; &lt;font color="#5E5D59"&gt;(observer)&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;two complete, legal role assignments,&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;one where C&lt;sub&gt;2&lt;/sub&gt; holds, one where it fails&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#141413;rounded=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#DEDCD3;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=6;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="646" y="132" width="262" height="82" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Fewest checks that decide C&lt;sub&gt;2&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;reveal seats 1 and 3: C&lt;sub&gt;2&lt;/sub&gt; is settled&lt;/font&gt;&lt;br&gt;&lt;font color="#5E5D59"&gt;whatever they are (CEGAR search)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#141413;rounded=1;arcSize=7;fillColor=#FFFFFF;strokeColor=#D97757;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=9;spacingRight=6;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="646" y="224" width="262" height="82" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=blockThin;endFill=1;endSize=7;strokeColor=#87867F;strokeWidth=1.6;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="291" y="173" as="sourcePoint"/><mxPoint x="312" y="173" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="" style="endArrow=blockThin;endFill=1;endSize=7;strokeColor=#87867F;strokeWidth=1.6;html=1;" edge="1" parent="1"><mxGeometry relative